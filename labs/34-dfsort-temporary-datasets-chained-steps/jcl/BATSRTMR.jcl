//BATSRTMR JOB (ACCT),'SORT COBOL FLOW',
//             CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID
//* LAB 34 - DFSORT TEMP DATASET TO COBOL
//SORTSTEP EXEC PGM=SORT
//SORTIN   DD DISP=SHR,DSN=IBMUSER.BATCH33.INPUT
//SORTOUT  DD DSN=&&SORTED,
//            DISP=(NEW,PASS),
//            UNIT=SYSDA,
//            SPACE=(TRK,(1,1)),
//            DCB=(RECFM=FB,LRECL=80)
//SYSOUT   DD SYSOUT=*
//SYSIN    DD *
  SORT FIELDS=(1,80,CH,A)
/*
//COBSTEP  EXEC PGM=BATMR
//STEPLIB  DD DISP=SHR,DSN=IBMUSER.COBOL.LOAD
//INFILE   DD DSN=&&SORTED,DISP=(OLD,DELETE)
//OUTFILE  DD DISP=OLD,DSN=IBMUSER.BATCH34.VALID
//REJFILE  DD DISP=OLD,DSN=IBMUSER.BATCH34.REJECT
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*

//BATSORT  JOB (ACCT),'SORT TEMP FLOW',
//             CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID
//* LAB 34 - DFSORT + TEMP DATASET + CHAINED STEPS
//SORTSTEP EXEC PGM=SORT
//SORTIN   DD DISP=SHR,DSN=IBMUSER.BATCH33.INPUT
//SORTOUT  DD DSN=&&SORTOUT,
//            DISP=(NEW,PASS),
//            UNIT=SYSDA,
//            SPACE=(TRK,(1,1)),
//            DCB=(RECFM=FB,LRECL=80)
//SYSOUT   DD SYSOUT=*
//SYSIN    DD *
  SORT FIELDS=(1,80,CH,A)

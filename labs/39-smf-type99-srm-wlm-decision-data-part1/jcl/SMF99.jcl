//SMF99    JOB (LAB39),'SMF TYPE 99',
//             CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID
//*
//* LAB39 - EXTRACT SMF TYPE 99 RECORDS
//* READ-ONLY ANALYSIS OF EXISTING SMF ARCHIVE
//*
//EXTRACT  EXEC PGM=IFASMFDP
//SYSPRINT DD SYSOUT=*
//SMFIN    DD DSN=IBMUSER.SMF.ARCHIVE(0),DISP=SHR
//SMF99OUT DD DSN=IBMUSER.SMF.TYPE99,
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=3390,
//             VOL=SER=ZVOL00,
//             SPACE=(CYL,(5,5),RLSE),
//             DCB=(RECFM=VBS,BLKSIZE=0)
//SYSIN    DD *
  INDD(SMFIN,OPTIONS(DUMP))
  OUTDD(SMF99OUT,TYPE(99))
/*
